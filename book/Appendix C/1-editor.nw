	const BY_SUFFIX = {
	  c: "c", h: "c",
	  cc: "cpp", cpp: "cpp", cxx: "cpp", hpp: "cpp", hh: "cpp", inl: "cpp",
	  cu: "cpp", cuh: "cpp",
	  rs: "rust",
	  py: "python",
	  js: "javascript", mjs: "javascript", cjs: "javascript",
	  ts: "typescript", tsx: "typescript",
	  go: "go", java: "java", kt: "kotlin",
	  sh: "shellscript", bash: "shellscript", zsh: "shellscript",
	  json: "json", jsonc: "jsonc",
	  yaml: "yaml", yml: "yaml", toml: "toml",
	  sql: "sql", lua: "lua", rb: "ruby", php: "php",
	  html: "html", htm: "html", css: "css", scss: "css",
	  md: "markdown", tex: "latex",
	  nix: "nix", zig: "zig", xml: "xml", svg: "xml",
	  nw: "nw"
	};

	// 文件名 → scopeName，和 scopeName → 文件。两种索引都要：
	// 找顶层语法用前者（后缀表给的是文件名），嵌套 include 只有 scope。
	let byScope = null;
	const scopeOfName = new Map();

	function readScope(file) {
	  const hit = /"scopeName"\s*:\s*"([^"]+)"/.exec(fs.readFileSync(file, "utf8"));
	  return hit ? hit[1] : null;
	}

	function byScopeIndex() {
	  if (!byScope) {
	    byScope = new Map();
	    for (const name of fs.readdirSync(GRAMMARS)) {
	      if (!name.endsWith(".json")) continue;
	      const file = path.join(GRAMMARS, name);
	      const scope = readScope(file);
	      if (scope) byScope.set(scope, file);
	    }
	  }
	  return byScope;
	}

	// 后缀表给的是文件名，这里换成 scopeName；换不出来就没有语法，那一块按纯文本。
	function scopeOf(name) {
	  if (!name) return null;
	  if (name === "nw") return "source.nw";
	  if (scopeOfName.has(name)) return scopeOfName.get(name);
	  let scope = null;
	  try {
	    scope = readScope(path.join(GRAMMARS, name + ".json"));
	  } catch (e) {
	    scope = null;
	  }
	  scopeOfName.set(name, scope);
	  return scope;
	}
~@

注册表只建一次：把 onig.wasm 交给 `vscode-oniguruma`，再把 oniguruma 交给 `vscode-textmate`。之后所有语法共用一个 registry，它自己缓存解析结果。`loadGrammar` 找不到语法时返回 `null`：textmate 会当作"这一段没有规则"，继续往下走——`tm-grammars` 没收的方言只是不着色，不是解析失败。

<< 注册表 >>= @
	let booting = null;

	function boot() {
	  if (!booting) {
	    booting = (async () => {
	      const wasm = fs.readFileSync(path.join(__dirname, "node_modules", "vscode-oniguruma", "release", "onig.wasm"));
	      await oniguruma.loadWASM(wasm.buffer.slice(wasm.byteOffset, wasm.byteOffset + wasm.byteLength));
	      return new vsctm.Registry({
	        onigLib: Promise.resolve({
	          createOnigScanner: (sources) => new oniguruma.OnigScanner(sources),
	          createOnigString: (text) => new oniguruma.OnigString(text)
	        }),
	        loadGrammar: async (scope) => {
	          const file = scope === "source.nw" ? OWN : byScopeIndex().get(scope);
	          if (!file) return null;
	          return vsctm.parseRawGrammar(fs.readFileSync(file, "utf8"), file);
	        }
	      });
	    })();
	  }
	  return booting;
	}
~@

块体缓存是这个插件唯一的性能手段：一段文本配一门语法，token 必然一样。打字时只有一块在变，其余块直接命中缓存；没有它，每敲一下都要把一整章重新解析一遍。键里带上 scope，因为同一段文本在 C++ 和 JSON 下是两个答案。

<< 块体缓存 >>= @
	const cache = new Map();
	const CACHE_MAX = 200;

	function remember(key, value) {
	  if (cache.size >= CACHE_MAX) cache.delete(cache.keys().next().value);
	  cache.set(key, value);
	}

	async function tokenizeBody(registry, scope, text) {
	  const key = scope + "/" + text;
	  const hit = cache.get(key);
	  if (hit) return hit;
	  const grammar = await registry.loadGrammar(scope);
	  const out = [];
	  const lines = text.split("\n");
	  let stack = vsctm.INITIAL;
	  for (let i = 0; i < lines.length; i += 1) {
	    const r = grammar.tokenizeLine(lines[i], stack);
	    stack = r.ruleStack;
	    for (const t of r.tokens) {
	      // textmate 对行尾会多算一格（空行甚至给 [0,1]），夹到行长；夹完是空的就丢掉。
	      const end = t.endIndex > lines[i].length ? lines[i].length : t.endIndex;
	      if (end <= t.startIndex) continue;
	      out.push({ line: i, start: t.startIndex, end: end, scopes: t.scopes });
	    }
	  }
	  remember(key, out);
	  return out;
	}
~@

切块这件事，一行正则也没有：几个 scope 名字就是和语法层的全部接口。判断顺序必须是"先看块头、再看收尾，最后才看语言"：块头那一行里也有名字，先按引用处理的话，块的深度根本不会加。

<< 切块 >>= @
	const BEGIN = "punctuation.definition.chunk.begin.nw";
	const END = "punctuation.definition.chunk.end.nw";
	const NAME = "entity.name.function.chunk.nw";
	const MARK = "keyword.control.head-marker.nw";
	const TERM = "keyword.control.chunk.terminator.nw";
	const TYPE = "storage.type.nw";
	const COMMENT = "comment.block.nw";

	const has = (r, name) => r.tokens.some((t) => t.scopes.indexOf(name) >= 0);
	const textOf = (r, name, line) => {
	  const t = r.tokens.find((x) => x.scopes.indexOf(name) >= 0);
	  return t ? line.slice(t.startIndex, t.endIndex) : null;
	};

	// nw 的注释 `%%…%%` 归结构，不归语言：C 会把这两个百分号读成取模。
	// 规矩与 tangle 一样——按行成对、不跨行。这里不删掉，而是换成等长空白再交给语言：
	// 列位置不变，注释里的引号也就带不坏后面那半行。
	const mask_comments = (line) => {
	  const spans = [];
	  let at = 0;
	  for (;;) {
	    const a = line.indexOf("%%", at);
	    if (a < 0) break;
	    const b = line.indexOf("%%", a + 2);
	    if (b < 0) break;
	    spans.push([a, b + 2]);
	    at = b + 2;
	  }
	  if (!spans.length) return { masked: line, spans };
	  let out = "";
	  let cut = 0;
	  for (const [a, b] of spans) {
	    out += line.slice(cut, a) + " ".repeat(b - a);
	    cut = b;
	  }
	  return { masked: out + line.slice(cut), spans };
	};

	// 第一遍：file<ext> … @ 里出现的引用，记成"块名 → ext"。
	// 一个块接进两个不同后缀时以第一次为准；纯片段查不到，体是单色。
	async function languages(lines, registry) {
	  const own = await registry.loadGrammar("source.nw");
	  const map = new Map();
	  let stack = vsctm.INITIAL;
	  let ext = null;
	  for (let i = 0; i < lines.length; i += 1) {
	    const r = own.tokenizeLine(lines[i], stack);
	    stack = r.ruleStack;
	    const opened = /^\s*file<([\w-]+)>\s+\S+\s*@\s*$/.exec(lines[i]);
	    if (opened) {
	      ext = opened[1];
	      continue;
	    }
	    if (has(r, TERM)) {
	      ext = null;
	      continue;
	    }
	    if (!ext) continue;
	    const name = textOf(r, NAME, lines[i]);
	    // 块头也有 NAME：块头带 MARK（= 与 @），引用不带。
	    if (name && !has(r, MARK)) map.set(name.trim(), ext);
	  }
	  return map;
	}

	async function tokens(text) {
	  const registry = await boot();
	  const own = await registry.loadGrammar("source.nw");
	  const lines = text.split("\n").map((line) => (line.endsWith("\r") ? line.slice(0, -1) : line));
	  const language = await languages(lines, registry);
	  const out = [];
	  let stack = vsctm.INITIAL;
	  let chunk = null;     // 当前块的名字：语言由它查表
	  let depth = 0;        // 块嵌套深度：0 就是正文
	  let from = -1;        // 正在攒的块体起始行

	  const flush = async (to) => {
	    const begin = from;
	    if (begin < 0 || to < begin) return;
	    from = -1;
	    const scope = scopeOf(language.get(chunk) || "");
	    if (!scope) return;
	    const seg = lines.slice(begin, to + 1);
	    const masked = [];
	    const marks = [];
	    for (const line of seg) {
	      const m = mask_comments(line);
	      masked.push(m.masked);
	      marks.push(m.spans);
	    }
	    const body = await tokenizeBody(registry, scope, masked.join("\n"));
	    for (const t of body) {
	      // 落在注释区间里的 token 是语言的误读（两个百分号被当成取模），丢掉。
	      const spans = marks[t.line] || [];
	      if (spans.some(([a, b]) => t.start < b && a < t.end)) continue;
	      out.push({ line: begin + t.line, start: t.start, end: t.end, scopes: t.scopes });
	    }
	    // 注释本身补回来：语言看不见它，但编辑器要看见。
	    for (let i = 0; i < marks.length; i += 1) {
	      for (const [a, b] of marks[i]) {
	        out.push({ line: begin + i, start: a, end: b, scopes: [scope, COMMENT] });
	      }
	    }
	  };

	  for (let i = 0; i < lines.length; i += 1) {
	    const r = own.tokenizeLine(lines[i], stack);
	    stack = r.ruleStack;
	    const name = textOf(r, NAME, lines[i]);
	    const isHead = has(r, MARK) && name && /^\s*<</.test(lines[i]);
	    if (isHead && has(r, BEGIN) && lines[i].includes("=")) {
	      await flush(i - 1);
	      chunk = name.trim();
	      depth += 1;
	      continue;
	    }
	    if (name && !has(r, MARK)) {
	      await flush(i - 1);     // 整行的引用不是代码：tangle 会把被引的块展开到这儿
	      continue;
	    }
	    if (has(r, TERM)) {
	      await flush(i - 1);
	      depth = Math.max(0, depth - 1);
	      continue;
	    }
	    if (has(r, "keyword.control.todo.nw")) {
	      await flush(i - 1);     // @todo 是结构行，体在它后面继续
	      continue;
	    }
	    if (depth === 0) continue;
	    if (from < 0) from = i;
	  }
	  await flush(lines.length - 1);
	  // 注释 token 是后补的，推入时必然乱序；语义 token 必须按行列递增。
	  out.sort((a, b) => a.line - b.line || a.start - b.start);
	  return out;
	}

	module.exports = { tokens };
~@

## 七、渲染层：只报类别，颜色在客户端

`classify.js` 只回答一个问题：这个 token 属于哪一类。答案不是颜色，是编辑器词汇表里的一个**语义类型**——`comment`、`string`、`function`、`type`……颜色的链条在客户端走完：语义类型 → 一组默认 scope → 当前主题的 `tokenColors`。这两跳一步都不到我们手里，所以块体的颜色和同一份主题里别处的颜色天然是一套，换主题跟着变。

这也是为什么不用装饰器：装饰器的 `color` 要一个具体色值，而色值只能从主题文件里读。扩展跑在**远程**窗口时，主题文件在客户端那台机器上——服务器端的扩展看得见工作区的文件，看不见你的主题。语义 token 没有这个问题：我们只报类别，颜色在渲染进程里算。

<< 渲染层 >>= @
	const TYPES = [
	  "comment", "string", "regexp", "number", "keyword", "operator", "function",
	  "variable", "parameter", "property", "type", "class", "struct", "interface",
	  "enum", "namespace", "macro", "decorator", "typeParameter", "enumMember"
	];

	const INDEX = new Map(TYPES.map((name, i) => [name, i]));

	// [scope 前缀, 语义类型]。顺序即优先级：具体的排前面（`storage.type` 必须早于 `storage`）。
	const RULES = [
	  ["comment", "comment"],
	  ["string.regexp", "regexp"],
	  ["string", "string"],
	  ["constant.regexp", "regexp"],
	  ["constant.numeric", "number"],
	  ["constant.character.escape", "string"],
	  ["constant.language", "variable"],
	  ["constant.other", "variable"],
	  ["keyword.operator", "operator"],
	  ["keyword.control.directive", "macro"],
	  ["entity.name.function.preprocessor", "macro"],
	  ["storage.type", "type"],
	  ["keyword", "keyword"],
	  ["storage", "keyword"],
	  ["entity.name.function", "function"],
	  ["support.function", "function"],
	  ["entity.name.type.struct", "struct"],
	  ["entity.name.type.enum", "enum"],
	  ["entity.name.type.interface", "interface"],
	  ["entity.name.type.class", "class"],
	  ["entity.name.type", "type"],
	  ["entity.name.namespace", "namespace"],
	  ["entity.name.tag", "type"],
	  ["entity.other.attribute-name", "property"],
	  ["support.type.property-name", "property"],
	  ["support.type", "type"],
	  ["support.class", "class"],
	  ["variable.parameter", "parameter"],
	  ["variable.language", "variable"],
	  ["variable.other.property", "property"],
	  ["variable.other.enummember", "enumMember"],
	  ["variable", "variable"],
	  ["meta.object-literal.key", "property"]
	];

	function fits(scope, prefix) {
	  return scope === prefix || scope.indexOf(prefix + ".") === 0;
	}

	// 由内往外：最里面的 scope 最具体，认不出来就问外面一层。
	function classify(scopes) {
	  for (let i = scopes.length - 1; i >= 0; i -= 1) {
	    for (const rule of RULES) {
	      if (fits(scopes[i], rule[0])) return INDEX.get(rule[1]);
	    }
	  }
	  return -1;
	}

	module.exports = { TYPES, classify };
~@

## 八、装配层：把 token 编码成编辑器要的格式

`extension.js` 主要做一件事：注册一个语义 token 提供者。要交的是一串整数，五个一组——`[相对行, 相对列, 长度, 类型, 修饰符]`，行列都相对于**上一个 token**，跨行时列从行首算。

另外挂两件"打字时的便利"，都是可选的糖，缺了不影响阅读：

- **补全**：在 `<<` 里列出本文档已定义的块名（后面没有 `>>` 就顺手补上）；行首打 `@` 给 `@todo:`；
- **回车**：在块头那行按回车，自动补一行缩进一级的空行与一行 `~@`，光标留在中间。

依赖缺席时必须降级而不是整块不激活：`require("vscode-textmate")` 会在加载阶段抛，扩展于是整块不激活，编辑器里一声不吭。所以这里兜住，`activate` 里再把原因说出来。

<< 装配 >>= @
	const vscode = require("vscode");
	const { TYPES, classify } = require("./classify");

	let tokens = null;
	let tokenizeError = null;
	try {
	  tokens = require("./tokenize").tokens;
	} catch (e) {
	  tokenizeError = e;
	}

	// 下标即编号：这个数组的顺序不能动，否则已注册的编号会全部错位。
	const legend = new vscode.SemanticTokensLegend(TYPES, []);

	function pack(list) {
	  const data = [];
	  let line = 0;
	  let start = 0;
	  for (const t of list) {
	    const type = classify(t.scopes);
	    if (type < 0) continue;
	    const length = t.end - t.start;
	    if (length <= 0) continue;
	    const deltaLine = t.line - line;
	    data.push(deltaLine, deltaLine === 0 ? t.start - start : t.start, length, type, 0);
	    line = t.line;
	    start = t.start;
	  }
	  return new vscode.SemanticTokens(new Uint32Array(data));
	}

	const provider = {
	  provideDocumentSemanticTokens(document) {
	    return tokens(document.getText()).then(pack);
	  }
	};

	// 块头行：`<< 名字 >>= @`。它只服务于"打字的便利"，不参与结构判定。
	const HEAD = /^([ \t]*)<<([^<>\n]+)>>[ \t]*=[ \t]*@[ \t]*$/;

	function chunkNames(document) {
	  const seen = new Set();
	  for (const raw of document.getText().split("\n")) {
	    const m = HEAD.exec(raw.replace(/\r$/, ""));
	    if (m && m[2].trim()) seen.add(m[2].trim());
	  }
	  return [...seen];
	}

	const completion = {
	  provideCompletionItems(document, at) {
	    const line = document.lineAt(at.line).text;
	    const before = line.slice(0, at.character);
	    const after = line.slice(at.character);

	    const inChunk = /<<([^<>\n]*)$/.exec(before);
	    if (inChunk) {
	      const range = new vscode.Range(new vscode.Position(at.line, inChunk.index + 2), at);
	      const close = after.indexOf(">>") >= 0 ? "" : " >>";
	      return chunkNames(document).map((name) => {
	        const item = new vscode.CompletionItem(name, vscode.CompletionItemKind.Reference);
	        item.range = range;
	        item.insertText = name + close;
	        return item;
	      });
	    }

	    const atMark = /^([ \t]*)@[a-z]*$/.exec(before);
	    if (atMark) {
	      const range = new vscode.Range(new vscode.Position(at.line, atMark[1].length), at);
	      return ["@todo: "].map((text) => {
	        const item = new vscode.CompletionItem(text.trim(), vscode.CompletionItemKind.Keyword);
	        item.range = range;
	        item.insertText = text;
	        return item;
	      });
	    }

	    return undefined;
	  }
	};

	// 照常打字：交给编辑器自己处理，自动缩进、列表续行、粘贴都还在。
	function fallback() {
	  return vscode.commands
	    .executeCommand("default:type", { text: "\n" })
	    .then(undefined, () => vscode.commands.executeCommand("type", { text: "\n" }));
	}

	// 块头那行回车：补一行缩进一级的空行，再补一行与块头同缩进的 `~@`。
	// 只在块头**行尾**生效：光标停在行中间时，补进去的两行会把块头劈开。
	async function enter() {
	  const editor = vscode.window.activeTextEditor;
	  if (!editor || !editor.selection.isEmpty) return fallback();
	  const at = editor.selection.active;
	  const line = editor.document.lineAt(at.line).text;
	  const m = HEAD.exec(line);
	  if (!m || line.slice(at.character).trim()) return fallback();
	  const body = m[1] + "\t";
	  const end = m[1] + "~@";
	  await editor.edit((b) => b.insert(at, "\n" + body + "\n" + end));
	  const to = new vscode.Position(at.line + 1, body.length);
	  editor.selection = new vscode.Selection(to, to);
	}

	function activate(context) {
	  context.subscriptions.push(
	    vscode.languages.registerCompletionItemProvider({ language: "nw" }, completion, "<", "@"),
	    vscode.commands.registerCommand("nw.enter", enter)
	  );
	  if (tokens) {
	    context.subscriptions.push(
	      vscode.languages.registerDocumentSemanticTokensProvider({ language: "nw" }, provider, legend)
	    );
	  } else {
	    vscode.window.showErrorMessage(
	      "Neoweb：语义着色未启用（" + tokenizeError.message + "）。在 tangle/editor 下跑 npm install，然后重载窗口。"
	    );
	  }
	  console.log("neoweb: 已激活（scope 由 TextMate 给，颜色由编辑器按主题上）");
	}

	function deactivate() {}

	module.exports = { activate, deactivate };
~@

## 九、调试命令

解析层与渲染层都不依赖编辑器，于是有一个不花编辑器也能跑的调试命令：给它一篇 `.nw`，它按行打印每个 token 的 scope 与类别。调块体着色之前先跑它，比在编辑器里猜快得多。

<< 调试命令 >>= @
	// 调试用：不开编辑器也能看见"这篇 .nw 里每个 token 的 scope，以及它被归到哪一类"。
	//   node tangle/editor/tools/tokens.js "book/Chapter 2/1-syntax.nw"
	const fs = require("fs");
	const { tokens } = require("../tokenize");
	const { TYPES, classify } = require("../classify");

	async function main() {
	  const file = process.argv[2];
	  if (!file) {
	    console.error("用法: node tools/tokens.js <文件.nw>");
	    process.exit(2);
	  }
	  const text = fs.readFileSync(file, "utf8");
	  const lines = text.split("\n");
	  for (const t of await tokens(text)) {
	    const lexeme = lines[t.line].slice(t.start, t.end);
	    if (!lexeme.trim()) continue;
	    const type = classify(t.scopes);
	    const name = type < 0 ? "-" : TYPES[type];
	    console.log(String(t.line + 1).padStart(4) + "  " + name.padEnd(10) + " " + JSON.stringify(lexeme).padEnd(22) + " " + t.scopes.slice(1).join(" "));
	  }
	}

	main().catch((e) => {
	  console.error(e);
	  process.exit(1);
	});
~@

## 十、图标

图标是文字形状，不是二进制素材，所以也由这份源生成：改配色就改这里。图案选"两行灰线 + 一块实心"——两行线是散文，实心块是代码，也就是这份文档的形状。**不用尖括号**：文件栏里会跟 HTML 的 `<>` 撞。

深浅两档必须同形，只换颜色。不同形的话，切换主题时图标会"跳"一下；而"跳"这种细节是编辑器里最先被注意到的东西。

图案在画布里**不左右对称**：左留 4.6、右留 0.6。这是对着文件栏量的，不是手误——同一行里 python/M 图标的墨迹从 14 起，我们的从 12 起，偏左 2px；整幅右移 2 个单位补上，墨迹就和邻居对齐了。**别把它"修正"回几何居中**，那样在文件栏里会重新偏左。

<< 图标浅 >>= @
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16">
	  <!-- .nw 文件图标（浅色档）。
	       两行灰线 = 散文，一块实心色块 = 代码：这就是这份文档的形状。
	       不用尖括号：文件栏里会跟 HTML 的 <> 撞。
	       配色沿用 weave 输出的强调色（暖色 #a4463c）与中性灰（#9aa5ad）。
	       左右不对称（左 4.6、右 0.6）是故意的：文件栏里按墨迹定位，对称画法实测偏左
	       2px（12–24 vs 邻居 14–26）。别"修正"回 2.6。 -->
	  <rect x="4.6" y="2.5" width="10.8" height="1.4" rx="0.7" fill="#9aa5ad"/>
	  <rect x="4.6" y="5.3" width="7.0" height="1.4" rx="0.7" fill="#9aa5ad"/>
	  <rect x="4.6" y="8.2" width="10.8" height="5.2" rx="1.5" fill="#a4463c"/>
	</svg>
~@

<< 图标深 >>= @
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16">
	  <!-- .nw 文件图标（深色档）。结构与浅色档完全一致，只换两个颜色：
	       中性灰提到 #7f8c96、强调色提到 #e59a90，否则在深底上糊成一团。
	       两档必须同形，否则切换主题时图标会"跳"一下。
	       左边留 4.6、右边留 0.6 的理由见浅色档。 -->
	  <rect x="4.6" y="2.5" width="10.8" height="1.4" rx="0.7" fill="#7f8c96"/>
	  <rect x="4.6" y="5.3" width="7.0" height="1.4" rx="0.7" fill="#7f8c96"/>
	  <rect x="4.6" y="8.2" width="10.8" height="5.2" rx="1.5" fill="#e59a90"/>
	</svg>
~@

file<svg> nw @
	<< 图标浅 >>
~@

file<svg> nw-dark @
	<< 图标深 >>
~@

## 十一、商店要的那几样

商店页面就是 README；包里必须带 LICENSE（仓库那条 GPL 不许在包内缺席）；`.vscodeignore` 把生成器与调试命令挡在包外。README 与 ignore 也是产物：它们描述的是这个包，改包就得改它们，放进 `.nw` 才不会各长各的。LICENSE 例外——它是仓库级事实，包里只该有它的副本，所以由构建从根目录拷一份。

<< 说明 >>= @
	# Better Neoweb

	Editor support for Neoweb literate programming: syntax highlighting for `.nw` files,
	**block bodies coloured by the language they are wired into**, completion, and a
	return-key convenience.

	## What it does

	- **Structure**: chunk headers, references, `dir` / `file` wiring, `!!` namespaces, `~@`, `~::`,
	  `%%` comments, `@todo` — colours come from your editor theme
	- **Block bodies**: a chunk wired into `file<c>` is read as C, `file<py>` as Python, and so on
	- **Semantic highlighting**: one more layer on top of TextMate — prose, code, comment
	- **Completion**: chunk names already defined in this document, offered inside `<<`
	- **Return key**: at the end of a chunk header, inserts an indented line and a matching `~@`

	## Install

	Search **Better Neoweb** in the marketplace (extension id `random25160765-collab.nw`).

	Offline, from a VSIX (the file name is `nw-<version>.vsix`):

	    code --install-extension nw-0.2.0.vsix

	For development you do not need to package anything — symlink the directory instead:

	    make ext

	## Dependencies

	Block-body colouring needs three Node packages: `vscode-textmate`, `vscode-oniguruma`
	and `tm-grammars`. This repository ships no `node_modules`, so run once:

	    make deps

	Without them nothing breaks as a whole: highlighting, completion and the return-key
	behaviour still work, block-body colouring is skipped, and a message tells you what is missing.

	## Relationship to `nw`

	The extension does not parse `.nw`. It only displays and types. Structure is settled by
	`nw check` and `nw tangle`:

	What looks right in the editor is not necessarily tangleable; being tangleable is what counts.
~@

