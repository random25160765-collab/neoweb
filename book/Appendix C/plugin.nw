### 6.3 装配层：把 token 编码成编辑器要的格式

`extension.js` 主要做一件事：注册一个语义 token 提供者。要交的是一串整数，五个一组——`[相对行, 相对列, 长度, 类型, 修饰符]`，行列都相对于**上一个 token**，跨行时列从行首算。这叫增量编码，不是压缩花招：编辑器内部就是这么存的，省的是它的内存。

另外挂两件"打字时的便利"，都是可选的糖，缺了不影响阅读：

- **补全**：在 `<<` 里列出本文档已定义的 chunk 名（后面没有 `>>` 就顺手补上），行首打 `@` 给出 `@after:` / `@before:` / `@todo:`；
- **回车**：在块头那行按回车，自动补一行缩进一级的空行 + 一行与块头同缩进的 `~@`，光标留在中间——省掉"写完代码再回去补收尾"。

这两件都用一条行正则认块头，**不参与结构判定**：结构仍然只有语法与解析层那一份，这里认错了最多少一条候选、少补一行 `~@`，不会让哪一行变成代码。回车命令声明在 `package.json` 的 `keybindings` 里，`when` 带 `editorLangId == nw`，别处不受影响；不匹配块头时交回 `default:type`，自动缩进、列表续行都照旧。

两个容易踩的地方：**`legend` 的顺序就是类型的编号**，所以那个数组不能随手排序，客户端按同一次注册里的次序解释我们填的数字；**交上去的 token 必须按位置递增且不重叠**，解析层给的就是这个顺序（TextMate 逐行吐 token，行内不重叠），所以这里不用排序，只是照着搬。

结构行不用再筛：解析层只吐块体里的 token，`~@` 和块头根本不在列表里。

主题关掉语义高亮时这层什么都不显示，所以激活时把那两个判定依据写进日志——下次不用再猜。

tangle/editor/extension.js @

<< extension.js >>= @

	// 装配层：把解析层的 token 编码成语义 token 注册上去；另外挂两件打字时的便利（补全、回车）。
	// 这一层没有语言规则，也没有色值。
	const vscode = require("vscode");
	const { TYPES, classify } = require("./classify");

	// 语义着色的两个引擎（oniguruma / textmate）是 runtime 依赖，不在仓库里。
	// 缺了它们，require 会在加载阶段直接抛——扩展于是整块不激活，编辑器里一声不吭。
	// 所以这里兜住：拿不到就降级，TextMate 语法、补全、回车照旧；activate 里再把原因说出来。
	let tokens = null;
	let tokenizeError = null;
	try {
	  tokens = require("./tokenize").tokens;
	} catch (e) {
	  tokenizeError = e;
	}

	// 下标即编号：这个数组的顺序不能动，否则已注册的编号会全部错位。
	const legend = new vscode.SemanticTokensLegend(TYPES, []);

	// 五个整数一个 token：[相对行, 相对列, 长度, 类型, 修饰符]。
	// 相对的是上一个 token；跨行时列从行首算。
	function pack(list) {
	  const data = [];
	  let line = 0;
	  let start = 0;
	  for (const t of list) {
	    const type = classify(t.scopes);
	    if (type < 0) continue;
	    const length = t.end - t.start;
	    if (length <= 0) continue;
	    const deltaLine = t.line - line;
	    data.push(deltaLine, deltaLine === 0 ? t.start - start : t.start, length, type, 0);
	    line = t.line;
	    start = t.start;
	  }
	  return new vscode.SemanticTokens(new Uint32Array(data));
	}

	const provider = {
	  provideDocumentSemanticTokens(document) {
	    return tokens(document.getText()).then(pack);
	  }
	};

	// 块头行：`<< 路径: 名字 >>= @`。它只服务于"打字的便利"，不参与结构判定——
	// 结构仍由语法与解析层决定；这里认错了，最多是少一条候选、少补一行 ~@。
	const HEAD = /^([ \t]*)<<([^<>\n]+)>>[ \t]*=[ \t]*@[ \t]*$/;

	// 文档里已定义的 chunk 名，按出现顺序去重。
	function chunkNames(document) {
	  const seen = new Set();
	  for (const raw of document.getText().split("\n")) {
	    const m = HEAD.exec(raw.replace(/\r$/, ""));
	    if (m && m[2].trim()) seen.add(m[2].trim());
	  }
	  return [...seen];
	}

	// 在 `<<` 里给名字，行首的 `@` 给修饰符：都只改光标附近那一段，不碰整篇。
	const completion = {
	  provideCompletionItems(document, at) {
	    const line = document.lineAt(at.line).text;
	    const before = line.slice(0, at.character);
	    const after = line.slice(at.character);

	    const inChunk = /<<([^<>\n]*)$/.exec(before);
	    if (inChunk) {
	      const range = new vscode.Range(new vscode.Position(at.line, inChunk.index + 2), at);
	      // 后面已经有 `>>` 就只补名字，否则连收尾一起补。
	      const close = after.indexOf(">>") >= 0 ? "" : " >>";
	      return chunkNames(document).map((name) => {
	        const item = new vscode.CompletionItem(name, vscode.CompletionItemKind.Reference);
	        item.range = range;
	        item.insertText = name + close;
	        return item;
	      });
	    }

	    const atMark = /^([ \t]*)@[a-z]*$/.exec(before);
	    if (atMark) {
	      const range = new vscode.Range(new vscode.Position(at.line, atMark[1].length), at);
	      return ["@after: ", "@before: ", "@todo: "].map((text) => {
	        const item = new vscode.CompletionItem(text.trim(), vscode.CompletionItemKind.Keyword);
	        item.range = range;
	        item.insertText = text;
	        return item;
	      });
	    }

	    return undefined;
	  }
	};

	// 照常打字：交给编辑器自己处理，自动缩进、列表续行、粘贴都还在。
	function fallback() {
	  return vscode.commands
	    .executeCommand("default:type", { text: "\n" })
	    .then(undefined, () => vscode.commands.executeCommand("type", { text: "\n" }));
	}

	// 块头那行回车：补一行缩进一级的空行，再补一行与块头同缩进的 `~@`，光标留在中间。
	// 只在块头**行尾**生效：光标停在行中间时，补进去的两行会把块头劈开，宁可交回默认行为。
	async function enter() {
	  const editor = vscode.window.activeTextEditor;
	  if (!editor || !editor.selection.isEmpty) return fallback();
	  const at = editor.selection.active;
	  const line = editor.document.lineAt(at.line).text;
	  const m = HEAD.exec(line);
	  if (!m || line.slice(at.character).trim()) return fallback();
	  const body = m[1] + "\t";
	  const end = m[1] + "~@";
	  await editor.edit((b) => b.insert(at, "\n" + body + "\n" + end));
	  const to = new vscode.Position(at.line + 1, body.length);
	  editor.selection = new vscode.Selection(to, to);
	}

	function activate(context) {
	  context.subscriptions.push(
	    vscode.languages.registerCompletionItemProvider({ language: "nw" }, completion, "<", "@"),
	    vscode.commands.registerCommand("nw.enter", enter)
	  );
	  if (tokens) {
	    context.subscriptions.push(
	      vscode.languages.registerDocumentSemanticTokensProvider({ language: "nw" }, provider, legend)
	    );
	  } else {
	    // 静默失效比失效本身更坏：让人知道缺什么、去哪儿补。
	    vscode.window.showErrorMessage(
	      "Neoweb：语义着色未启用（" + tokenizeError.message + "）。在 tangle/editor 下跑 npm install，然后重载窗口。"
	    );
	  }
	  console.log("neoweb: 已激活（scope 由 TextMate 给，颜色由编辑器按主题上）", {
	    theme: vscode.workspace.getConfiguration("workbench").get("colorTheme"),
	    semanticHighlighting: vscode.workspace.getConfiguration("editor").get("semanticHighlighting.enabled")
	  });
	}

	function deactivate() {}

	module.exports = { activate, deactivate };

~@

~@

### 6.4 分层以后能看见什么

分层的收益不只是"好看"：解析层和渲染层都不依赖编辑器，于是有一个不花编辑器也能跑的调试命令。给它一篇 `.nw`，它按行打印每个 token 的 scope 和它被归到哪一类。**没有颜色那一列**——这条链路里根本没有颜色，颜色在客户端。

调块体着色之前先跑它，比在编辑器里猜快得多。

tangle/editor/tools/tokens.js @

<< tokens tool >>= @

	// 调试用：不开编辑器也能看见"这篇 .nw 里每个 token 的 scope，以及它被归到哪一类"。
	//
	//   node tangle/editor/tools/tokens.js "book/Chapter 2/1-syntax.nw"
	//
	// 没有颜色：颜色在客户端按主题算，不在这条链路里。
	const fs = require("fs");
	const { tokens } = require("../tokenize");
	const { TYPES, classify } = require("../classify");

	async function main() {
	  const file = process.argv[2];
	  if (!file) {
	    console.error("用法: node tools/tokens.js <文件.nw>");
	    process.exit(2);
	  }
	  const text = fs.readFileSync(file, "utf8");
	  const lines = text.split("\n");
	  for (const t of await tokens(text)) {
	    const lexeme = lines[t.line].slice(t.start, t.end);
	    if (!lexeme.trim()) continue;
	    const type = classify(t.scopes);
	    const name = type < 0 ? "-" : TYPES[type];
	    console.log(String(t.line + 1).padStart(4) + "  " + name.padEnd(10) + " " + JSON.stringify(lexeme).padEnd(22) + " " + t.scopes.slice(1).join(" "));
	  }
	}

	main().catch((e) => {
	  console.error(e);
	  process.exit(1);
	});

~@

~@

## 七、图标

图标是文字形状，不是二进制素材，所以也由这份源生成：改配色就改这里，不必额外记一个文件。

图案选"两行灰线 + 一块实心"——两行线是散文，实心块是代码，也就是这份文档的形状。**不用尖括号**：文件栏里会跟 HTML 的 `<>` 撞。

深浅两档必须同形，只换颜色。不同形的话，切换主题时图标会"跳"一下；而"跳"这种细节是编辑器里最先被注意到的东西。

图案在画布里**不左右对称**：左留 4.6、右留 0.6。这是对着文件栏量的，不是手误——同一行里 python/M 图标的墨迹从 14 起，我们的从 12 起，偏左 2px；整幅右移 2 个单位补上，墨迹就和邻居对齐了。**别把它"修正"回几何居中**，那样在文件栏里会重新偏左。

tangle/editor/icons/nw.svg @

<< icon light >>= @
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16">
	  <!-- .nw 文件图标（浅色档）。
	       两行灰线 = 散文，一块实心色块 = 代码：这就是这份文档的形状。
	       不用尖括号：文件栏里会跟 HTML 的 <> 撞。
	       配色沿用 weave 输出的强调色（暖色 #a4463c）与中性灰（#9aa5ad）。
	       左右不对称（左 4.6、右 0.6）是故意的：文件栏里按墨迹定位，对称画法实测偏左
	       2px（12–24 vs 邻居 14–26）。别"修正"回 2.6。 -->
	  <rect x="4.6" y="2.5" width="10.8" height="1.4" rx="0.7" fill="#9aa5ad"/>
	  <rect x="4.6" y="5.3" width="7.0" height="1.4" rx="0.7" fill="#9aa5ad"/>
	  <rect x="4.6" y="8.2" width="10.8" height="5.2" rx="1.5" fill="#a4463c"/>
	</svg>
