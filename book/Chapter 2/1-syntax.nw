	count("S6.1", "提到即声明：被引用的块不单独落盘", """a.c @
	<< top >>= { << ghost >> }
	<< ghost >>= { g }
	~@
	""", chunk=2, product=1)
	
	eq("S6.2", "重新赋值最后一次生效", """a.c @
	<< x >>= { old }
	<< x >>= { new }
	~@
	""", "new\n")
	
	bad("S6.2b", "只声明没赋值", """a.c @
	<< top >>= { << x >> }
	~@
	""", "只声明没有定义：x")
	
	eq("S6.3", "纯片段从任何文件都看得见", """<< shared >>= @
		SHARED
	~@
	src/a.c @
	<< m >>= @
		<< shared >>
	~@
	~@
	""", "SHARED\n", product="src/a.c")
	
	bad("S6.4", "循环引用", """a.c @
	<< p >>= { << q >> }
	<< q >>= { << p >> }
	~@
	""", "chunk 循环引用")
	````
