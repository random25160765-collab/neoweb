	div.math-block math { font-size:1.12em; }
	figure.wire { margin:1.4rem 0; }
	figure.wire pre.code { margin:0; border:1px dashed var(--line); border-radius:var(--radius); }
	table { border-collapse:collapse; width:100%; margin:1.4rem 0; font-size:.92rem; }
	th,td { text-align:left; padding:.5rem .75rem; border-bottom:1px solid var(--line); vertical-align:top; }
	th { font-weight:600; background:var(--code); }
	figure.chunk { margin:1.6rem 0; border:1px solid var(--line); border-radius:var(--radius);
	  overflow:hidden; scroll-margin-top:1.5rem; }
	figure.chunk:target { border-color:var(--accent); }
	figure.chunk figcaption { display:flex; gap:.55rem; align-items:baseline; flex-wrap:wrap;
	  padding:.5rem .95rem; background:var(--code); border-bottom:1px solid var(--line);
	  font-family:var(--mono); font-size:.78rem; }
	figure.chunk .seq { color:var(--accent); font-weight:700; font-variant-numeric:tabular-nums; }
	figure.chunk a.cname { color:var(--fg); }
	figure.chunk a.cname:hover { color:var(--accent); text-decoration:none; }
	figure.chunk .home { margin-left:auto; color:var(--dim); }
	figure.chunk a.tree { color:var(--dim); font-size:.78rem; padding-left:.5rem; }
	figure.chunk a.tree:hover { color:var(--accent); text-decoration:none; }
	ul.tree { list-style:none; margin:.35rem 0; padding:0 0 0 1.1rem; border-left:1px solid var(--line);
	  line-height:1.5; }
	ul.tree li { margin:.06rem 0; }
	ul.tree li.branch { margin:.34rem 0 .1rem; }
	ul.tree summary { position:relative; cursor:pointer; list-style:none; }
	ul.tree summary::marker { content:""; }
	ul.tree summary::-webkit-details-marker { display:none; }
	ul.tree summary::before { content:""; position:absolute; left:-.65rem; top:.5em;
	  border-left:6px solid var(--dim); border-top:5px solid transparent; border-bottom:5px solid transparent;
	  transition:transform .12s ease; }
	ul.tree details[open] > summary::before { transform:rotate(90deg); }
	ul.tree summary:hover::before { border-left-color:var(--accent); }
	ul.tree summary:hover .ns, ul.tree summary:hover .dir, ul.tree summary:hover .file { color:var(--accent); }
	ul.tree .ns { font-weight:600; }
	ul.tree .dir { font-family:var(--mono); font-size:.86rem; font-weight:600; }
	ul.tree .file { font-family:var(--mono); font-size:.86rem; }
	ul.tree .block { color:var(--dim); font-family:var(--mono); font-size:.82rem; }
	ul.tree .qid { color:var(--dim); font-family:var(--mono); font-size:.72rem; opacity:.55; margin-left:.3rem; }
	ul.tree a { color:var(--accent); }
	ul.tree .home { color:var(--dim); font-size:.78rem; opacity:.7; margin-left:.35rem; }
	p.lead { color:var(--dim); margin-top:-.4rem; }
	span.inst { color:var(--accent); }
	span.inst.miss { color:var(--red); text-decoration:line-through; }
	.miss { color:var(--red); }
	.pager { display:flex; justify-content:space-between; gap:1rem; margin:4.5rem 0 0;
	  padding-top:1.4rem; border-top:1px solid var(--line); font-size:.9rem; }
	@media (max-width:64rem) {
	  nav.side { position:static; width:auto; height:auto; border-right:0;
	    border-bottom:1px solid var(--line); padding:1.2rem 1.4rem; }
	  main { margin-left:0; padding:2.2rem 1.4rem 4rem; }
	}
	@media print {
	  nav.side { display:none; }
	  main { margin:0; padding:0; }
	  article { max-width:none; }
	  a { color:inherit; }
	  figure.chunk, pre.code, pre.sample, figure.diagram { break-inside:avoid; }
	}
	)CSS";
	}
~@

样式只有一条判据：**读者不该注意到它**。所以颜色先收进 `:root` 的七个 token 里，正文里不再出现一个色号；圆角只有一个值（`--radius`），要么全是 6px，要么一处都不改；行宽固定成 `--measure`，`main` 与 `article` 两层的职责分开——前者管留白，后者管行长。

两档 `@media` 各答一件事：窄屏把左栏落回顶部变成普通目录；打印把左栏整条拿掉、链接去色、块不许跨页断开。`prefers-color-scheme` 一个都不写——这本书不做深色档，一份没设计过的深色版比没有更糟。

锚点也有样式：`figure.chunk:target` 让"点进来的那一块"描边变强调色。没有这一条，从两棵树跳回正文后，读者还得自己在一屏里找刚才是哪一块。

`pre.code` 底下那五行是给着色器配的颜色。着色器只负责把代码切成 `class="keyword"` 这样的词，**颜色不在它手里**——它自带的那份样式表有二十几个色号，装进来这本书就成了调色盘。这里只认四类：注释（次要字，斜体）、关键字与预处理（红）、类型（强调色）、字符串与数字（棕、蓝）。剩下的 `normal`、`symbol`、`cbracket` 没有规则，继承正文字色——这正是要的：标点不该抢眼。

这份对照表有个前提：类名是 `source-highlight` 的契约，换一个着色器就得换一张表。所以它写在样式里、不写在 `highlight` 里——**换引擎时改的是颜色，不是逻辑**。

## 六、页面外壳

外壳只做四件事：写 `<!doctype>`、把样式塞进 `<style>`、把导航与正文摆进两个容器、在 `</body>` 之前放那一段左栏滚动记忆。它不知道正文里有什么，也不知道导航从哪来——**两者都是字符串，谁调用谁负责**。

那十行脚本是整份 HTML 里唯一的一段 JavaScript，理由也只有一条：侧栏滚到哪，浏览器不负责记。翻页是整页加载，`nav` 又从顶部开始，读者刚拖到"第 5 章"、点进去，回来时又得拖一遍。用 `sessionStorage` 记住一个数字就能解决，而它坏掉时页面完全照常——**便利可以依赖脚本，可读性不行**。

<< 页面外壳 >>= @
	// 左栏的滚动位置存进 sessionStorage：翻页是一次整页加载，浏览器不会替你记住侧栏滚到哪儿。
	// 没有脚本时退化成"每次从顶部开始"，也就是这一段不存在的效果——所以它只能算便利，
	// 不能算功能：页面的可读性一点也不依赖它。
	// 第一次进站（还没存过）时，把当前篇滚进视野，省掉"找我在哪"。
	const char* nav_scroll_js() {
		return R"JS(
	(function(){
	  try{
	    var nav=document.querySelector("nav.side");
	    if(!nav) return;
	    var key="nw-nav";
	    var raw=sessionStorage.getItem(key);
	    if(raw!==null){ nav.scrollTop=parseInt(raw,10)||0; }
	    else { var here=nav.querySelector("a.here"); if(here&&here.scrollIntoView) here.scrollIntoView({block:"nearest"}); }
	    nav.addEventListener("scroll",function(){ try{ sessionStorage.setItem(key,String(nav.scrollTop)); }catch(e){} },{passive:true});
	  }catch(e){}
	})();
	)JS";
	}

	// 外壳不认识正文，也不认识导航：两者都是字符串，谁调用谁负责。
	string page_shell(const string& title, const string& nav, const string& body) {
		std::ostringstream out;
		out << "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n"
		    << "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
		    << "<title>" << html_escape(title) << "</title>\n<style>" << css() << "</style>\n</head>\n<body>\n";
		if (!nav.empty()) out << "<nav class=\"side\">" << nav << "</nav>\n";
		out << "<main><article>\n" << body << "</article></main>\n<script>" << nav_scroll_js() << "</script>\n</body>\n</html>\n";
		return out.str();
	}
~@

## 七、这一篇到哪为止

块、颜色、样式、外壳都在了，但**还没有人调用它们**：谁把一篇源走成一块一块、谁决定序号、谁拼这一页，是后面两篇的事。

验收仍是编译这一层（同样带临时豁免，等接线的人出现就取消）：

```
python3 nw3.py tangle -o /tmp/w5 book/skeleton.nw "book/Chapter 3"/*.nw book/Chapter\ 4/1-cli.nw book/Chapter\ 5/*.nw
g++ -std=c++17 -Wall -Wextra -Wno-unused-function -I/tmp/w5 -c /tmp/w5/weave.cpp
```

但着色现在就能真跑：把一段本文里的代码喂给 `highlight`，看它吐出来的是不是只有 `<span class="…">`，没有那些外壳。下一篇是目录——一页之所以能叫"书里的一页"，是因为它知道自己在书里的位置。
