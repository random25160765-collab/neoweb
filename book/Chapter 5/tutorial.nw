	````
	# 第九课：写出你自己的第一篇

	模板没有了。硬性的验收只有两条：check 过，产物至少 2 个。
	软的纪律列在下面——check 不查它们，但读你文件的人会：

	- 先声明整棵树，再逐块实现：先在顶块里把结构引用一遍，定义写在后面。
	  反过来写的代价，第三课见过了：产物里多一份。
	- 一个块只做一件事，块名用动词短语：`parse_args`，不是 `b2`。
	- 散文解释"为什么"，块体只放"是什么"：解释要写超过两行，就挪进散文。
	- 产物路径写在命名空间行里，别在每块的头里重复。
	- 散文里讨论语法，用反引号或围栏——否则讨论本身会变成代码。

	建议的形状：一个 `排序.c @` 这样的命名空间，顶块先引用还没定义的名字，
	然后逐块补体。写什么都行——一个排序、一个玩具解释器、一份笔记的骨架。

	从这行往下写。
	````
	)NW",
		 "从零写一篇：check 过，产物至少 2 个。纪律清单在稿子里。", 2},
	};

	// 回车继续；Ctrl-D（或管道读完）就收工，别把人卡在循环里。
	static bool wait_enter() {
		string line;
		return static_cast<bool>(std::getline(std::cin, line));
	}

	static void edit_in(const string& path) {
		const char* ed = std::getenv("EDITOR");
		string cmd = string(ed && *ed ? ed : "vi") + " \"" + path + "\"";
		if (std::system(cmd.c_str()) == -1) throw Error("<tutorial>", 0, "起不来编辑器：" + cmd);
	}

	// 与 check 走同一条路：解析 + 展开，不写盘。达标返回 true，产物带回去给教程打印。
	static bool check_one(const string& path, int want_products, vector<Product>& ps, string& bad) {
		try {
			Document doc = parse(read_file(path), path);
			ps = tangle(doc, path, false);
			if (static_cast<int>(ps.size()) < want_products) {
				bad = "还差一点：这一步要 " + std::to_string(want_products) + " 个产物，现在只有 " +
				      std::to_string(ps.size()) + " 个";
				return false;
			}
			return true;
		} catch (const Error& e) {
			ps.clear();
			bad = e.where();
			return false;
		}
	}

	static int cmd_tutorial(const Args&) {
		// 临时目录：学习者会改坏稿子，改坏的东西不该落在任何仓库里。
		string base = (std::filesystem::temp_directory_path() / "nw-tutorial-XXXXXX").string();
		vector<char> buf(base.c_str(), base.c_str() + base.size() + 1);
		if (!mkdtemp(buf.data())) throw Error("<tutorial>", 0, "建不了临时目录");
		string dir(buf.data());
		int n = static_cast<int>(sizeof(LESSONS) / sizeof(LESSONS[0]));

		std::cout << "neoweb 教程：" << n << " 课，从“一份文件，两种读者”走到写出你自己的一篇。\n"
		          << "稿子建在 " << dir << "\n"
		          << "每课：回车打开稿子，改完存盘退出，我展开一遍——过了把产物打给你看。\n";
		for (int i = 0; i < n; ++i) {
			const Lesson& l = LESSONS[i];
			string path = dir + "/" + l.file;
			// 文件已经存在就不重写：重跑同一课不该抹掉人的改动。
			if (!std::ifstream(path)) write_file(path, l.start);
			while (true) {
				std::cout << "\n=== 第 " << (i + 1) << "/" << n << " 课：" << l.file << " ===\n"
				          << l.goal << "\n\n回车开始编辑（Ctrl-D 退出）：";
				if (!wait_enter()) {
					std::cout << "\n";
					return 0;
				}
				edit_in(path);
				vector<Product> ps;
				string bad;
				if (!check_one(path, l.want_products, ps, bad)) {
					std::cout << "\n" << bad << "\n";
					continue;   // 没过：报错原样给，回车再来一遍
				}
				std::cout << "✓ 过了。\n";
				// check 只保证"展开得动"；设计上的对错——顺序、份数、缩进——它不看。
				// 产物打出来，眼睛验收。
				for (const auto& p : ps) {
					std::cout << "\n--- " << p.path << " ---\n";
					for (const auto& ln : p.lines) std::cout << ln << "\n";
				}
				// "过了"不等于"改到满意了"：眼睛验收的课要留回炉的口子。
				std::cout << "\n回车进入下一课；这一课还想改，输入 e 再回车：";
				string line;
				if (!std::getline(std::cin, line)) {
					std::cout << "\n";
					return 0;
				}
				if (trim(line) == "e") continue;   // 回炉：再走一遍编辑 → check
				break;
			}
		}
		std::cout << "\n" << n << " 课走完。稿子留在 " << dir << "，想带走就复制出去；"
		          << "删掉这个目录再跑一次，从第一课重来。\n";
		return 0;
	}

~@

